#!/bin/bash
# Entry point for the senior-dev agent. Everything a script can do is done here, before the agent starts.
#   dev implement <tech-specs/PROJ-142.md>   (run from the project's clone)
#   dev review <https://github.com/org/repo/pull/12>
#
# implement, in order:
#   1. validate the ticket format (validate-tech-spec.sh) and read its metadata
#   2. set up the repository: the worktree of the ticket's branch (setup-repo.sh)
#   3. start the agent inside the worktree, with the metadata in its first message
# The agent never validates the ticket or sets up the repo: it receives the result and reads the content.
set -euo pipefail
BIN="$(cd "$(dirname "$0")" && pwd)"
# Lets the agent call the scripts by name (a plugin's bin/ does the same). validate-tech-spec.sh comes from the
# specs plugin: if it is not already on the PATH, use the one next to dev-agent in a marketplace clone.
export PATH="$BIN:$BIN/../../specs/bin:$PATH"

usage() { sed -n '3,4p' "$0" | sed 's/^#  //' >&2; exit 2; }
die() { echo "dev: $*" >&2; exit 1; }

# Fields of the metadata and of the setup result. They come from a ticket, so they are read as data
# (a fixed list of keys, never eval).
id=""; repo=""; base=""; stack=""; type=""; story=""; depends_on=""; acceptance_criteria=""
worktree=""; branch=""; status=""; behind=""
read_fields() {   # stdin: key=value lines
  local key val
  while IFS='=' read -r key val; do
    case "$key" in
      id|repo|base|stack|type|story|depends_on|acceptance_criteria|worktree|branch|status|behind)
        printf -v "$key" '%s' "$val" ;;
    esac
  done
}

implement_ticket() {
  local ticket="$1"
  [ -f "$ticket" ] || die "ticket not found: $ticket"
  ticket="$(cd "$(dirname "$ticket")" && pwd)/$(basename "$ticket")"

  # 1. validate, read the metadata (the validator prints every error and exits on an invalid ticket)
  command -v validate-tech-spec.sh >/dev/null || die "validate-tech-spec.sh not found: install the specs plugin (see plugins/dev-agent/README.md)"
  local meta; meta="$(validate-tech-spec.sh "$ticket")"
  read_fields <<< "$meta"
  echo "Ticket OK ($id)"

  # 2. set up the repo (run from the project's clone: the script checks its origin)
  local setup; setup="$(setup-repo.sh "$repo" "$base" "$id")"
  read_fields <<< "$setup"
  echo "Worktree $status: $worktree"

  # 3. start the agent in the worktree: everything it needs to know is in the message
  local prompt
  prompt="implement $ticket
id=$id
repo=$repo
base=$base
stack=$stack
type=$type
story=$story
depends_on=$depends_on
acceptance_criteria=$acceptance_criteria
worktree=$worktree
branch=$branch
status=$status
behind=$behind"
  cd "$worktree"
  exec claude --agent dev-agent:senior-dev "$prompt"
}

case "${1:-}" in
  implement)
    [ -z "${2:-}" ] && usage
    implement_ticket "$2"
    ;;
  review)
    url="${2:-}"; [ -z "$url" ] && usage
    echo "$url" | grep -Eq '^https://github\.com/[^/]+/[^/]+/pull/[0-9]+' || die "not a GitHub PR URL: $url"
    exec claude --agent dev-agent:senior-dev "review $url"
    ;;
  *) usage ;;
esac
