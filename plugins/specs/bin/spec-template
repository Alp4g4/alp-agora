#!/bin/bash
# spec-template: prints a spec template on stdout, so an agent can start from it without knowing where
# the plugin is installed.
#
# Usage:   spec-template tech
#          spec-template --help
set -eu

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

case "${1:-}" in
  tech)        cat "$ROOT/templates/tech-spec.md" ;;
  --help|-h)   sed -n '2,/^set -eu$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *)           echo "usage: spec-template tech" >&2; exit 2 ;;
esac
